+// Semaphore (PS Vita kernel semaphore). The newlib/pthread sem_* functions poll every
+// 0.5 ms to support cancellation; the kernel's own semaphore sleeps until signalled.
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+	SceUID m_sema;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+	Semaphore(int initialCount = 0)
+	{
+		m_sema = sceKernelCreateSema("mc_sema", 0, initialCount, 0x7FFFFFFF, nullptr);
+		assert(m_sema >= 0);
+	}
+	~Semaphore() { sceKernelDeleteSema(m_sema); }
+	bool wait() { return sceKernelWaitSema(m_sema, 1, nullptr) >= 0; }
